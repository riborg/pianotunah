# Copy to .env and adjust. Read by docker compose.
#
# Set up for Traefik. For another reverse proxy, remove everything below
# and see the README.

COMPOSE_FILE=compose.yaml:compose.traefik.yaml

# Hostname for the Traefik router. The microphone requires https.
PIANOTUNAH_HOST=pianotunah.example.com

# Existing Docker network that Traefik uses to reach the container.
TRAEFIK_NETWORK=proxy

# Traefik entrypoint for https.
TRAEFIK_ENTRYPOINT=websecure

# Comma-separated Traefik middlewares, e.g. an IP allowlist to keep the
# app on the LAN only. Must not be empty.
TRAEFIK_MIDDLEWARES=ip-allowlist@file
