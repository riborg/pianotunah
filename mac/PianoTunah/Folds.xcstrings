{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ beats/s" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ svävningar/s"
          }
        }
      }
    },
    "B: how far the string's overtones lie above whole multiples of the fundamental, from its stiffness. The stretch is computed from it. Press, then strike the key firmly." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "B: hur mycket strängens övertoner ligger över hela multipler av grundtonen, på grund av styvheten. Stretchen räknas ut från den. Tryck, och slå sedan an tangenten kraftigt."
          }
        }
      }
    },
    "Beatless" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svävningsfritt"
          }
        }
      }
    },
    "Beats around the target, ±30 cents" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svävningar runt målet, ±30 cent"
          }
        }
      }
    },
    "Could not measure inharmonicity. Strike the key firmly and let it ring for a couple of seconds." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunde inte mäta inharmonicitet. Slå an tangenten kraftigt och låt den klinga i ett par sekunder."
          }
        }
      }
    },
    "Deviation per partial for the sounding key. Highlighted = the one being measured." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvikelse per delton för tangenten som klingar. Markerad = den som mäts."
          }
        }
      }
    },
    "Higher partial" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högre delton"
          }
        }
      }
    },
    "Inharmonicity B = %@ (measured)" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inharmonicitet B = %@ (uppmätt)"
          }
        }
      }
    },
    "Inharmonicity B = %@ (measured, differs from the neighbours and is not used)" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inharmonicitet B = %@ (uppmätt, avviker från grannarna och används inte)"
          }
        }
      }
    },
    "Inharmonicity B = %@ (model)" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inharmonicitet B = %@ (modell)"
          }
        }
      }
    },
    "Inharmonicity for %@: B = %@" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inharmonicitet för %1$@: B = %2$@"
          }
        }
      }
    },
    "Inharmonicity for %@: B = %@, far from the neighbouring keys, so it is not used. Measure again." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inharmonicitet för %1$@: B = %2$@, långt från grannarna, så den används inte. Mät igen."
          }
        }
      }
    },
    "Lower partial" : {
      "localizations" : {
