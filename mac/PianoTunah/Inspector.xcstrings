    "Bass" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bas"
          }
        }
      }
    },
    "Choose the octave type for bass, middle and treble yourself." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj oktavtyp för bas, mitt och diskant själv."
          }
        }
      }
    },
    "Counted from A0 = 1; 0 = none. The tuning order uses it for which keys need a wedge and which have no unison to tune." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räknat från A0 = 1; 0 = inga. Arbetsordningen använder det för vilka tangenter som behöver kil och vilka som saknar kor att renstämma."
          }
        }
      }
    },
    "Custom" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egen"
          }
        }
      }
    },
    "C–G–D–A–E are narrowed by 1/4 syntonic comma (pure major third C–E), F♯–C♯ by a schisma." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C–G–D–A–E minskas 1/4 syntoniskt komma (ren stor ters C–E), F♯–C♯ minskas ett schisma."
          }
        }
      }
    },
    "Delete…" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radera…"
          }
        }
      }
    },
    "Double string unison (DSU)" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbelsträngsunison (DSU)"
          }
        }
      }
    },
    "Duplicate" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duplicera"
          }
        }
