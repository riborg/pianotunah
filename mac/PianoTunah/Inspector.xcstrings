    "Equal temperament" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liksvävande"
          }
        }
      }
    },
    "Every fifth is narrowed by the same amount (1/12 Pythagorean comma). Standard for modern pianos; all keys sound alike." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla kvinter minskas lika mycket (1/12 pytagoreiskt komma). Standard för moderna pianon; alla tonarter låter lika."
          }
        }
      }
    },
    "Exactly 1200 cents per octave. Sounds too narrow on a real piano; useful for comparison." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exakt 1200 cent per oktav. Låter för smalt på ett riktigt piano, användbart som jämförelse."
          }
        }
      }
    },
    "Export…" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportera…"
          }
        }
      }
    },
    "Extra bass" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extra bas"
          }
        }
      }
    },
    "Extra treble" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extra diskant"
          }
        }
      }
    },
    "Fixed average curve after Railsback’s measurements (≈ −25 cents at A0, +30 cents at C8). Does not use inharmonicity." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast genomsnittskurva efter Railsbacks mätningar (≈ −25 cent på A0, +30 cent på C8). Använder inte inharmonicitet."
          }
        }
      }
    },
    "For harpsichords, organs and early music. Modern pianos are tuned in equal temperament; with the others some keys sound out of tune." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För cembalo, orgel och tidig musik. Moderna pianon stäms liksvävande; med de andra låter vissa tonarter ostämda."
          }
        }
      }
    },
    "Four fifths (C–G, G–D, D–A, B–F♯) are narrowed by 1/4 PC, the rest are pure. Keys with few accidentals sound purer." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyra kvinter (C–G, G–D, D–A, B–F♯) minskas 1/4 PC, resten rena. Tonarter med få förtecken låter renare."
          }
        }
      }
    },
