    "Play A4 (or survey a few keys in the middle) so the app can measure the piano’s pitch." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spela A4 (eller kartlägg några tangenter i mitten) så kan appen mäta pianots tonhöjd."
          }
        }
      }
    },
    "Presets" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förval"
          }
        }
      }
    },
    "Pure 2:1 octaves in the treble and 4:2 in the bass. Good for small pianos and a soft sound." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rena 2:1-oktaver i diskanten och 4:2 i basen. Bra för små pianon och mjuk klang."
          }
        }
      }
    },
    "Pure major thirds in the common keys. The wolf fifth G♯–E♭ makes remote keys unusable." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rena stora terser i de vanliga tonarterna. Vargkvint G♯–E♭ gör avlägsna tonarter oanvändbara."
          }
        }
      }
    },
