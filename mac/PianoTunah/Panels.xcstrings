    "Reference set to %@ from the piano’s current pitch." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Referensen satt till %@ efter pianots nuvarande tonhöjd."
          }
        }
      }
    },
    "Save the pass to the history and start over?" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spara omgången i historiken och börja om?"
