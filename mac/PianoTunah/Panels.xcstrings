      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grovstämning."
          }
        }
      }
    },
    "Play A4 (or survey a few keys in the middle) so the app can measure the piano’s pitch." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spela A4 (eller kartlägg några tangenter i mitten) så kan appen mäta pianots tonhöjd."
          }
        }
      }
    },
    "Previous" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Föregående"
          }
        }
      }
    },
    "Pull the strip %@–%@" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta ur filten %@–%@"
          }
        }
      }
    },
    "Pull the strip from %@ and tune its outer strings pure against the middle one." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta ur filten vid %@ och stäm de yttre strängarna rena mot den mittersta."
          }
        }
      }
    },
    "Pull the wedge and tune the second string of %@ pure against the first." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta bort kilen och stäm andra strängen i %@ ren mot den första."
          }
        }
      }
    },
    "Raise %@, all its strings." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra upp %@, alla strängar."
