{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ beats %@ faster than %@." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ svävar %@ snabbare än %@."
          }
        }
      }
    },
    "%@ died away before the measurement was done. Strike it again." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ klingade ut innan mätningen var klar. Slå an den igen."
          }
        }
      }
    },
    "%@ is %@ cents off: tune it again." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ligger %@ cent fel: stäm om den."
