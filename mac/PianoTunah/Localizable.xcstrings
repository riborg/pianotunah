        }
      }
    },
    "The input runs at %@ kHz. Piano Tunah measures best at 44.1 or 48 kHz." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingången går med %@ kHz. Piano Tunah mäter bäst med 44,1 eller 48 kHz."
          }
        }
      }
    },
    "The note beats, twice a second or faster. Mute all strings but one with a felt strip or wedge." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tonen svävar, två gånger i sekunden eller fortare. Dämpa alla strängar utom en med filtremsa eller kil."
          }
        }
      }
    },
