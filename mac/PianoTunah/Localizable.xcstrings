          }
        }
      }
    },
    "%@ sounded %@ cents from its last reading. Not saved; strike it again to save it." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lät %@ cent från förra avläsningen. Sparas inte; slå an igen för att spara."
          }
        }
      }
    },
